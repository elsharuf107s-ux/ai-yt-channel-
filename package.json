{
  "name": "ai-shell",
  "version": "0.1.0",
  "private": true,
  "description": "A Hugging Face–powered AI shell: the brain runs in a Codespace, the hands (browser) run on your own computer.",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "bridge": "node scripts/local-bridge.js",
    "check": "node scripts/check.js",
    "test": "node --test test/*.test.js",
    "setup:local-model": "npm install --save-optional @huggingface/transformers",
    "setup:llama": "node scripts/setup-llama.js",
    "setup:model": "node scripts/setup-model.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^5.1.0",
    "playwright": "^1.58.2"
  }
}
