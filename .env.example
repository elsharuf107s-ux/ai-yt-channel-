PORT=3000
# Hugging Face access token (https://huggingface.co/settings/tokens) — or paste it in Settings
HF_TOKEN=
# hf-api = hosted Hugging Face models, hf-local = small model inside the Codespace
AI_SHELL_BACKEND=hf-api
AI_SHELL_TEXT_MODEL=Qwen/Qwen2.5-72B-Instruct
AI_SHELL_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
AI_SHELL_LOCAL_MODEL=onnx-community/Qwen2.5-0.5B-Instruct
# ask = approve risky actions, strict = approve almost everything, auto = never ask
AI_SHELL_AUTONOMY=ask
# Optional shared secret the local bridge must send
AI_SHELL_BRIDGE_TOKEN=
# Extra hostnames allowed in the Host header (comma separated)
ALLOWED_HOSTS=
